{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "title": "DCWF Framework Profile Graph Ingest",
    "type": "object",
    "properties": {
        "schema_profile": {
            "const": "framework"
        },
        "records": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "source": {
                        "type": "object",
                        "properties": {
                            "label": {
                                "type": "string",
                                "enum": [
                                    "Framework",
                                    "DCWFFramework",
                                    "FunctionalCommunity",
                                    "WorkForceElement"
                                ]
                            },
                            "properties": {
                                "type": "object",
                                "properties": {
                                    "id": {
                                        "type": "string"
                                    },
                                    "name": {
                                        "type": "string"
                                    },
                                    "description": {
                                        "type": "string"
                                    },
                                    "authoritativeSource": {
                                        "type": "string",
                                        "format": "uri"
                                    },
                                    "competencyDefinition": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    },
                                    "profile": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    },
                                    "domain": {
                                        "type": "string"
                                    },
                                    "conformsTo": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "id",
                                    "name"
                                ],
                                "additionalProperties": false
                            }
                        },
                        "required": [
                            "label",
                            "properties"
                        ],
                        "additionalProperties": false
                    },
                    "destination": {
                        "type": "object",
                        "properties": {
                            "label": {
                                "type": "string",
                                "enum": [
                                    "Framework",
                                    "DCWFFramework",
                                    "FunctionalCommunity",
                                    "WorkForceElement"
                                ]
                            },
                            "properties": {
                                "type": "object",
                                "properties": {
                                    "id": {
                                        "type": "string"
                                    },
                                    "name": {
                                        "type": "string"
                                    },
                                    "description": {
                                        "type": "string"
                                    },
                                    "authoritativeSource": {
                                        "type": "string",
                                        "format": "uri"
                                    },
                                    "competencyDefinition": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    },
                                    "profile": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    },
                                    "domain": {
                                        "type": "string"
                                    },
                                    "conformsTo": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "id",
                                    "name"
                                ],
                                "additionalProperties": false
                            }
                        },
                        "required": [
                            "label",
                            "properties"
                        ],
                        "additionalProperties": false
                    },
                    "edge_label": {
                        "type": "string",
                        "enum": [
                            "has_subframework",
                            "HAS_SUBFRAMEWORK"
                        ]
                    }
                },
                "required": [
                    "source",
                    "destination",
                    "edge_label"
                ],
                "additionalProperties": false
            }
        }
    },
    "required": [
        "schema_profile",
        "records"
    ],
    "additionalProperties": false
}