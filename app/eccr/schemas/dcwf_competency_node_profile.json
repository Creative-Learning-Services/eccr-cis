{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "title": "DCWFCompetency Node Profile",
    "type": "object",
    "properties": {
        "node_type": {
            "const": "DCWFCompetency"
        },
        "label": {
            "const": "DCWFCompetency"
        },
        "labels": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "const": [
                "DCWFCompetency",
                "Competency"
            ]
        },
        "properties": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "competencyStatement": {
                    "type": "string"
                },
                "isSupportedBy": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "resourceAssociation": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "competencyFramework": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "referenceCode": {
                    "type": "string"
                },
                "competencyLevel": {
                    "type": "string"
                },
                "typeLabel": {
                    "type": "string"
                },
                "typeUri": {
                    "type": "string",
                    "format": "uri"
                },
                "type": {
                    "type": "string"
                },
                "typeURI": {
                    "type": "string",
                    "format": "uri"
                },
                "AssessmentRubric": {
                    "type": "string",
                    "format": "uri"
                },
                "NISTID": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "DCWFID": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "profile": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "conformsTo": {
                    "type": "string"
                },
                "domain": {
                    "type": "string"
                }
            },
            "required": [
                "id",
                "name"
            ],
            "additionalProperties": false
        }
    },
    "required": [
        "properties"
    ],
    "additionalProperties": false
}