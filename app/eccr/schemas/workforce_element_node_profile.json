{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "title": "WorkForceElement Node Profile",
    "type": "object",
    "properties": {
        "label": {
            "const": "WorkForceElement"
        },
        "properties": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "authoritativeSource": {
                    "type": "string",
                    "format": "uri"
                },
                "competencyDefinition": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "profile": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "domain": {
                    "type": "string"
                },
                "conformsTo": {
                    "type": "string"
                }
            },
            "required": [
                "id",
                "name"
            ],
            "additionalProperties": false
        }
    },
    "required": [
        "label",
        "properties"
    ],
    "additionalProperties": false
}