{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "title": "Node Label Mappings Configuration",
    "description": "Defines the mapping between primary and secondary labels for Neo4j node creation",
    "type": "object",
    "properties": {
        "mappings": {
            "type": "object",
            "description": "Maps primary labels to their corresponding secondary labels",
            "properties": {
                "Framework": {
                    "type": "array",
                    "description": "Secondary labels for Framework nodes",
                    "items": {
                        "type": "string",
                        "enum": [
                            "DCWFFramework",
                            "FunctionalCommunity",
                            "WorkForceElement"
                        ]
                    }
                },
                "Competency": {
                    "type": "array",
                    "description": "Secondary labels for Competency nodes",
                    "items": {
                        "type": "string",
                        "enum": [
                            "Job",
                            "AdvancedWorkRole",
                            "BasicWorkRole",
                            "IntermediateWorkRole",
                            "KsatsAbility",
                            "KsatsKnowledge",
                            "KsatsSkill",
                            "KsatsTask",
                            "DCWFCompetency"
                        ]
                    }
                }
            },
            "additionalProperties": false
        },
        "specific_type_mappings": {
            "type": "object",
            "description": "Maps specific node types to their label combinations",
            "patternProperties": {
                "^[A-Za-z][A-Za-z0-9]*$": {
                    "type": "object",
                    "properties": {
                        "primary_label": {
                            "type": "string",
                            "description": "The primary/base label for this node type"
                        },
                        "secondary_label": {
                            "type": "string",
                            "description": "The specific/type label for this node type"
                        },
                        "schema_file": {
                            "type": "string",
                            "description": "The JSON schema file that validates this node type",
                            "pattern": ".*\\.json$"
                        }
                    },
                    "required": [
                        "primary_label",
                        "secondary_label",
                        "schema_file"
                    ],
                    "additionalProperties": false
                }
            }
        }
    },
    "required": [
        "mappings",
        "specific_type_mappings"
    ],
    "additionalProperties": false
}